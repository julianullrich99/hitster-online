# Spotify API credentials
# Register a free app at https://developer.spotify.com/dashboard
# Deck building uses Client Credentials only. The optional "Full songs" audio mode
# (Spotify Connect) additionally needs this redirect URI registered in the dashboard,
# and the Spotify accounts that log in added under User Management:
#   <origin>/api/spotify/connect/callback   e.g. https://your-app.fly.dev/api/spotify/connect/callback
# Spotify accepts only HTTPS or loopback (http://127.0.0.1:<port>) redirect URIs.
# Set SPOTIFY_REDIRECT_URI to override the URI derived from the request.
# SPOTIFY_REDIRECT_URI=https://your-app.fly.dev/api/spotify/connect/callback
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Server port (HTTP + WebSocket). Vite dev proxy reads this from server/.env.
PORT=3000

# Spotify genre decks (optional)
# SPOTIFY_MARKET=US
# SPOTIFY_MIN_POPULARITY=70
# /recommendations returns 404 for new/dev apps (Spotify Nov 2024); search fallback is automatic.
# SPOTIFY_USE_RECOMMENDATIONS=false

# Test / demo mode — set to "true" to skip Spotify entirely.
# The server will use a built-in set of mock tracks so the game
# can be run and tested without real API credentials.
# Never set this in production.
TEST_MODE=false
